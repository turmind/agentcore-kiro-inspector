{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ValidatePolicies",
      "Effect": "Allow",
      "Action": "access-analyzer:ValidatePolicy",
      "Resource": "*"
    },
    {
      "Sid": "EcrRepoAndPush",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:GetRepositoryPolicy",
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchDeleteImage",
        "ecr:DeleteRepository"
      ],
      "Resource": "arn:aws:ecr:<REGION>:<ACCOUNT>:repository/bedrock-agentcore-kiro-inspector"
    },
    {
      "Sid": "ManageInspectorRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:CreateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:DetachRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT>:role/KiroInspectorBedrockAgentCoreRole",
        "arn:aws:iam::<ACCOUNT>:role/KiroInspectorSchedulerRole"
      ]
    },
    {
      "Sid": "PassSchedulerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT>:role/KiroInspectorSchedulerRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Sid": "SchedulerGroupAndSchedules",
      "Effect": "Allow",
      "Action": [
        "scheduler:GetScheduleGroup",
        "scheduler:CreateScheduleGroup",
        "scheduler:DeleteScheduleGroup",
        "scheduler:GetSchedule",
        "scheduler:CreateSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Resource": [
        "arn:aws:scheduler:<REGION>:<ACCOUNT>:schedule-group/kiro-inspector",
        "arn:aws:scheduler:<REGION>:<ACCOUNT>:schedule/kiro-inspector/*"
      ]
    },
    {
      "Sid": "SchedulerList",
      "Effect": "Allow",
      "Action": "scheduler:ListSchedules",
      "Resource": "*"
    },
    {
      "Sid": "NetworkPreflightReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSubnets",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeFlowLogs",
        "ec2:DescribeNetworkInterfaces"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InspectorLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:FilterLogEvents",
        "logs:DeleteLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:<REGION>:<ACCOUNT>:log-group:/aws/bedrock-agentcore/runtimes/*"
      ]
    },
    {
      "Sid": "NeverOpenAnInboundPath",
      "Effect": "Deny",
      "Action": [
        "bedrock-agentcore:PutResourcePolicy",
        "bedrock-agentcore:InvokeAgentRuntimeForUser",
        "bedrock-agentcore:InvokeAgentRuntimeWithWebSocketStreamForUser",
        "bedrock-agentcore:GetWorkloadAccessTokenForUserId",
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig",
        "lambda:AddPermission",
        "ecr:SetRepositoryPolicy"
      ],
      "Resource": "*"
    }
  ]
}
