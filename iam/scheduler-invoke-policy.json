{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeInspectorRuntime",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeAgentRuntime",
      "Resource": [
        "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT>:runtime/<RUNTIME_ID>",
        "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT>:runtime/<RUNTIME_ID>/runtime-endpoint/*"
      ]
    }
  ]
}
